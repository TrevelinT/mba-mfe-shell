{
	"name": "mfe-shell",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"engines": {
		"node": "24.15.0",
		"npm": "11.12.1"
	},
	"scripts": {
		"dev": "vite --port 5000",
		"build": "tsc && vite build",
		"build:local": "VITE_MFE_REMOTES=local npm run build",
		"preview": "vite preview --port 5000",
		"type-check": "tsc --noEmit",
		"format-and-lint": "biome check .",
		"format-and-lint:fix": "biome check . --write",
		"test": "vitest run",
		"test:watch": "vitest",
		"test-coverage": "vitest run --coverage",
		"test:e2e": "playwright test",
		"test:e2e:ui": "playwright test --ui",
		"test:e2e:update-snapshots": "playwright test --update-snapshots --grep @visual",
		"report-build-artifacts": "node scripts/report-build-artifacts.mjs",
		"changeset": "changeset",
		"version-packages": "changeset version",
		"release": "node scripts/release.mjs"
	},
	"dependencies": {
		"@trevelint/mfe-config": "0.1.0",
		"react": "19.2.6",
		"react-dom": "19.2.6"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.15",
		"@changesets/changelog-github": "0.7.0",
		"@changesets/cli": "2.31.1",
		"@originjs/vite-plugin-federation": "1.4.1",
		"@playwright/test": "1.60.0",
		"@tailwindcss/vite": "4.3.0",
		"@testing-library/jest-dom": "6.9.1",
		"@testing-library/react": "16.3.0",
		"@types/node": "25.9.1",
		"@types/react": "19.2.15",
		"@types/react-dom": "19.2.3",
		"@vitejs/plugin-react": "6.0.2",
		"@vitest/coverage-v8": "3.2.4",
		"jsdom": "26.1.0",
		"puppeteer": "24.15.0",
		"tailwindcss": "4.3.0",
		"typescript": "6.0.3",
		"vite": "8.0.13",
		"vitest": "3.2.4"
	}
}
