# Copy to .env.development or .env.production (gitignored) to override defaults.
# Without those files: development → local remotes, production build → GitHub Pages.

# Federation remote strategy: local (localhost preview ports) or pages (GitHub Pages).
VITE_MFE_REMOTES=local

# GitHub Pages origin for remotes (no trailing slash).
# VITE_PAGES_ORIGIN=https://trevelint.github.io

# Optional per-remote overrides (full remoteEntry.js URL).
# VITE_REMOTE_PRODUCT_URL=
# VITE_REMOTE_BUY_BOX_URL=
# VITE_REMOTE_CART_URL=
